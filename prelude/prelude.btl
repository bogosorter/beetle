type List<a> {
    ListConstructor((a, List<a>)),
    ListNil({})
}

(>>)(left: [a], right: [a]) -> [a] {
    return match left {
        ListNil -> right,
        ListConstructor(list) -> {
            head, tail = list;
            return head :: (tail >> right);
        }
    };
}

fold(f: a -> b -> b, accumulator: b, list: [a]) -> b {
    return match list {
        ListNil -> accumulator,
        ListConstructor(list) -> {
            head, tail = list;
            return f(head, fold(f, accumulator, tail));
        }
    };
}

alias String for [Character];

export;
