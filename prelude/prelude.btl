List<a> = ListConstructor (a, List<a>) | ListNil {};

(>>)(left: [a], right: [a]): [a] =
    if left is []: return right;

    head, tail = left;
    return head :: (tail >> right);

fold(f: a -> b -> b, accumulator: b, list: [a]): b =
    if list is []: return accumulator;
    head, tail = list;
    return f(head, fold(f, accumulator, tail));

String = [Character];

export;
