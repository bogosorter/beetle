type Tree<a> {
    Leaf(a),
    Node({left: Tree<a>, right: Tree<a>})
}

size(tree: Tree<a>) -> Integer {
    match tree {
        Leaf -> 1,
        Node(node) -> 1 + size(node.left) + size(node.right)
    }
}

tree = Node ({
    left: Leaf(1),
    right: Node({
        left: Node({
            left: Leaf(2),
            right: Leaf(3)
        }),
        right: Leaf (4),
    })
});

return size(tree);
