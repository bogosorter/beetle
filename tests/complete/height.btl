type Tree<a> {
    Leaf(a),
    Node({left: Tree<a>, right: Tree<a>})
}

max(a: Integer, b: Integer) -> Integer {
    if a >= b: return a;
    return b;
}

height(tree: Tree<a>) -> Integer {
    match tree {
        Leaf -> 0,
        Node(node) -> 1 + height(node.left) + height(node.right)
    }
}

tree = Node ({
    left: Leaf(1),
    right: Node({
        left: Node({
            left: Leaf(2),
            right: Leaf(3)
        }),
        right: Leaf (4),
    })
});

return height(tree);
