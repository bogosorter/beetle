Tree<a> = Leaf a | Node {left: Tree<a>, right: Tree<a>};

max(a: Integer, b: Integer): Integer =
    if a >= b: return a;
    return b;

height(tree: Tree<a>): Integer =
    if tree is Leaf: return 0;

    left = height(tree.left);
    right = height(tree.right);
    return 1 + max(left, right);

tree = Node {
    left: Leaf 1,
    right: Node {
        left: Node {
            left: Leaf 2,
            right: Leaf 3
        },
        right: Leaf 4,
    }
};

return height(tree);
