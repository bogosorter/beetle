Tree = Leaf integer | Node {left: Tree, right: Tree};

max(a: integer, b: integer): integer =
    if a >= b: return a;
    return b;

height(tree: Tree): integer =
    if tree is Leaf: return 0;

    left = height(tree.left);
    right = height(tree.right);
    return 1 + max(left, right);

tree = Node {
    left: Leaf 1,
    right: Node {
        left: Node {
            left: Leaf 2,
            right: Leaf 3
        },
        right: Leaf 4,
    }
};

return height(tree);
