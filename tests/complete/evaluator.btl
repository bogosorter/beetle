Expression
    = Literal integer
    | Addition {left: Expression, right: Expression}
    | Subtraction {left: Expression, right: Expression}
    | Multiplication {left: Expression, right: Expression}
    | Division {left: Expression, right: Expression}
    ;

eval(expression: Expression): integer =
    if expression is Addition: return eval(expression.left) + eval(expression.right);
    if expression is Subtraction: return eval(expression.left) - eval(expression.right);
    if expression is Multiplication: return eval(expression.left) * eval(expression.right);
    if expression is Division: return eval(expression.left) / eval(expression.right);
    -- Literal
    return expression;

return eval(
    Addition {
        left: Literal 1,
        right: Subtraction {
            left: Multiplication {
                left: Literal 2,
                right: Division {left: Literal 4, right: Literal 2}
            },
            right: Literal 2
        }
    }
);
