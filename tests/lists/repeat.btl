repeat(n: Integer, x: a): List<a> =
    if n == 0: return [];
    return x :: repeat(n - 1, x);

result = repeat(3, true);

-- Utils to print the result

booleanToString(b: Boolean): String =
    if not b: return 'false';
    return 'true';

intercalate(separator: String, list: [Boolean]): String =
    if list is []: return '';

    head, tail = list;
    if tail is []: return booleanToString(head);

    return booleanToString(head) >> separator >> intercalate(separator, ListConstructor tail);

listToString(list: [Boolean]): String =
    return '[' >> intercalate(', ', list) >> ']';

return listToString(result);
