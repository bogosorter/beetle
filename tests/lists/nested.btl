sum(list: [Integer]) -> Integer {
    match list {
        ListNil -> 0,
        ListConstructor(constructor) -> {
            head, tail = constructor;
            return head + sum(tail);
        }
    }
}

sumAll(list: [[Integer]]) -> Integer {
    match list {
        ListNil -> 0,
        ListConstructor(constructor) -> {
            head, tail = constructor;
            return sum(head) + sumAll(tail);
        }
    }
}

list = [[1, 2], [3, 4]];
return sumAll(list);
