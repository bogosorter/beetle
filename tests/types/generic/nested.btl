List a = Constructor (a, List a) | Nil {};

sum(list: List Integer): Integer =
    if list is Nil: return 0;
    head, tail = list;
    return head + sum(tail);

sumAll(list: List (List Integer)): Integer =
    if list is Nil: return 0;
    head, tail = list;
    return sum(head) + sumAll(tail);

