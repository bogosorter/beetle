type MyList {
    Cons((Integer, MyList)),
    Nil({})
}

length(list: MyList) -> Integer {
    match list {
        Nil -> 0,
        Cons(constructor) -> {
            _, tail = constructor;
            return 1 + length(tail);
        }
    }
}

list = Cons((1, Cons((2, Cons((3, Nil({})))))));
return length(list);
