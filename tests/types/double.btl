List = Cons (integer, List) | Nil {};

double(list: List): List =
    if list is Nil: return Nil {};
    head, tail = list;
    return Cons (head * 2, double(tail));

list = Cons (1, Cons (2, Cons (3, Nil {})));
list = double(list);

if list is Nil: return -1;
_, list = list;
if list is Nil: return -1;
second, _ = list;

return second;
