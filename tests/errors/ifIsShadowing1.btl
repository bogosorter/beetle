-- When a is shadowed, its imposible constructors should be removed from the
-- environment, such that if a is later reassigned a sum type no assumptions
-- are made about it based on the previously known impossible constructors.

type Sum {
    Left(Integer),
    Middle(Integer),
    Right(Integer)
}

a = Left(1);
if a is Left(n): return n;

a = Left(1);
if a is Middle(n): return n;

Right(n) = a;
return n;
