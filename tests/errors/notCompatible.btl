List<a> = Constructor (a, List<a>) | Nil {};

f(n: Integer): Boolean = return n > 0;

count(f: a -> Boolean, list: List<a>): Integer =
    if list is Nil: return 0;

    head, tail = list;
    if f(head): return 1 + count(f, tail);
    return count(f, tail);

list = Constructor ("a", Constructor ("b", Constructor ("c", Nil {})));
return sum(f, list);
